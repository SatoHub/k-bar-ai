# PostgreSQL
POSTGRES_USER=kbar
POSTGRES_PASSWORD=kbar_dev_password
POSTGRES_DB=kbar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://kbar:kbar_dev_password@localhost:5432/kbar

# pgAdmin
PGADMIN_EMAIL=admin@kbar.local
PGADMIN_PASSWORD=admin

# Kaggle (optional - can also place CSV in data/ manually)
KAGGLE_USERNAME=
KAGGLE_KEY=

# App
APP_ENV=development

# Demo / utility scripts & health-check (do NOT commit real values)
# Used by backend/scripts/demo_*.py and check_races.sh
KBAR_API_BASE=http://localhost:8000/api/v1
KBAR_API_USER=
KBAR_API_PASS=
# Playwright production health-check (set these in frontend/.env.local)
# HEALTHCHECK_URL=https://your-host
# HEALTHCHECK_USER=admin
# HEALTHCHECK_PASS=
# JV-Data VPS sync (backend/jravan/sync_jravan_derived_to_vps.sh)
# VPS_HOST=user@your-host
# VPS_KEY=/path/to/ssh_key
